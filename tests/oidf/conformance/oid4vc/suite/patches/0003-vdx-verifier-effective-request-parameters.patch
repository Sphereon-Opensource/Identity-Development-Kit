@@ -0,0 +1,53 @@
+package net.openid.conformance.condition.as;
+
+import com.google.gson.JsonObject;
+import net.openid.conformance.condition.Condition.ConditionResult;
+import net.openid.conformance.logging.BsonEncoding;
+import net.openid.conformance.logging.TestInstanceEventLog;
+import net.openid.conformance.testmodule.Environment;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+public class VP1FinalEncryptVPResponse_UnitTest {
+
+	private Environment env;
+
+	private VP1FinalEncryptVPResponse cond;
+
+	@BeforeEach
+	public void setUp() {
+		env = new Environment();
+		TestInstanceEventLog eventLog = BsonEncoding.testInstanceEventLog();
+		cond = new VP1FinalEncryptVPResponse();
+		cond.setProperties("UNIT-TEST", eventLog, ConditionResult.INFO);
+	}
+
+	@Test
+	public void readsEncryptionMetadataFromEffectiveAuthorizationRequest() {
+		env.putObjectFromJsonString(CreateEffectiveAuthorizationRequestParameters.ENV_KEY, "client_metadata", """
+			{
+			  "jwks": { "keys": [{
+			    "kty": "EC",
+			    "crv": "P-256",
+			    "x": "DxiH5Q4Yx3UrukE2lWCErq8N8bqC9CHLLrAwLz5BmE0",
+			    "y": "XtLM4-3h5o3HUH0MHVJV0kyq0iBlrBwlh8qEDMZ4-Pc",
+			    "use": "enc",
+			    "alg": "ECDH-ES",
+			    "kid": "1"
+			  }]},
+			  "encrypted_response_enc_values_supported": ["A128GCM"]
+			}
+			""");
+		JsonObject response = new JsonObject();
+		response.addProperty("state", "state-123");
+		env.putObject(CreateAuthorizationEndpointResponseParams.ENV_KEY, response);
+
+		cond.execute(env);
+
+		String encryptedResponse = env.getString("direct_post_request_form_parameters", "response");
+		assertThat(encryptedResponse).isNotBlank();
+		assertThat(encryptedResponse.split("\\.")).hasSize(5);
+	}
+}
