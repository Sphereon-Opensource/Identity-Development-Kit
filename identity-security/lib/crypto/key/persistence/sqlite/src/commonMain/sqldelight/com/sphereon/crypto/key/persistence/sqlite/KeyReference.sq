-- Key Reference Database Schema (SQLite)
-- Stores tenant-aware key reference metadata only — no key material.
-- Uses TEXT for timestamps (ISO8601 format)

CREATE TABLE IF NOT EXISTS key_reference (
    id TEXT NOT NULL PRIMARY KEY,
    tenant_id TEXT NOT NULL,
    alias TEXT NOT NULL,
    kid TEXT,
    provider_id TEXT NOT NULL,
    origin TEXT NOT NULL DEFAULT 'managed',
    key_type TEXT,
    signature_algorithm TEXT,
    key_visibility TEXT,
    key_encoding TEXT,
    created_at TEXT NOT NULL,
    created_by_id TEXT,
    updated_at TEXT NOT NULL,
    updated_by_id TEXT,
    deleted_at TEXT,
    deleted_by_id TEXT,
    -- Serialized public JWK. Nullable only for rows written before this column existed; those are
    -- filled in on first read. Never holds private or symmetric material.
    public_key_jwk TEXT,
    control_mode TEXT NOT NULL DEFAULT 'platform_managed',
    wallet_unit_id TEXT
);

-- Unique constraints (partial indexes excluding soft-deleted rows)
CREATE UNIQUE INDEX IF NOT EXISTS idx_key_ref_tenant_alias_provider
    ON key_reference(tenant_id, alias, provider_id)
    WHERE deleted_at IS NULL;

CREATE UNIQUE INDEX IF NOT EXISTS idx_key_ref_tenant_kid_provider
    ON key_reference(tenant_id, kid, provider_id)
    WHERE deleted_at IS NULL AND kid IS NOT NULL;

-- Lookup indexes
CREATE INDEX IF NOT EXISTS idx_key_ref_tenant_id ON key_reference(tenant_id);
CREATE INDEX IF NOT EXISTS idx_key_ref_tenant_kid ON key_reference(tenant_id, kid);
CREATE INDEX IF NOT EXISTS idx_key_ref_tenant_provider ON key_reference(tenant_id, provider_id);
CREATE INDEX IF NOT EXISTS idx_key_ref_origin ON key_reference(origin);

-- =====================
-- Queries
-- =====================

findById:
SELECT * FROM key_reference
WHERE tenant_id = :tenantId AND id = :id AND deleted_at IS NULL;

findByKid:
SELECT * FROM key_reference
WHERE tenant_id = :tenantId AND kid = :kid AND deleted_at IS NULL
  AND (:providerId IS NULL OR provider_id = :providerId)
ORDER BY updated_at DESC, created_at DESC, id DESC
LIMIT 1;

findByAlias:
SELECT * FROM key_reference
WHERE tenant_id = :tenantId AND alias = :alias AND deleted_at IS NULL
  AND (:providerId IS NULL OR provider_id = :providerId)
ORDER BY updated_at DESC, created_at DESC, id DESC
LIMIT 1;

findAllActiveByAlias:
SELECT * FROM key_reference
WHERE tenant_id = :tenantId AND alias = :alias AND deleted_at IS NULL
  AND (:providerId IS NULL OR provider_id = :providerId)
ORDER BY updated_at DESC, created_at DESC, id DESC;

findAllActiveByKid:
SELECT * FROM key_reference
WHERE tenant_id = :tenantId AND kid = :kid AND deleted_at IS NULL
  AND (:providerId IS NULL OR provider_id = :providerId)
ORDER BY updated_at DESC, created_at DESC, id DESC;

findAllByAliasIncludingDeleted:
SELECT * FROM key_reference
WHERE tenant_id = :tenantId AND alias = :alias
  AND (:providerId IS NULL OR provider_id = :providerId)
ORDER BY deleted_at DESC, updated_at DESC, created_at DESC, id DESC;

findAllByKidIncludingDeleted:
SELECT * FROM key_reference
WHERE tenant_id = :tenantId AND kid = :kid
  AND (:providerId IS NULL OR provider_id = :providerId)
ORDER BY deleted_at DESC, updated_at DESC, created_at DESC, id DESC;

findLatestByAliasIncludingDeleted:
SELECT * FROM key_reference
WHERE tenant_id = :tenantId AND alias = :alias
  AND (:providerId IS NULL OR provider_id = :providerId)
ORDER BY CASE WHEN deleted_at IS NULL THEN 0 ELSE 1 END ASC,
         deleted_at DESC, updated_at DESC, created_at DESC, id DESC
LIMIT 1;

findLatestByKidIncludingDeleted:
SELECT * FROM key_reference
WHERE tenant_id = :tenantId AND kid = :kid
  AND (:providerId IS NULL OR provider_id = :providerId)
ORDER BY CASE WHEN deleted_at IS NULL THEN 0 ELSE 1 END ASC,
         deleted_at DESC, updated_at DESC, created_at DESC, id DESC
LIMIT 1;

findAll:
SELECT * FROM key_reference
WHERE tenant_id = :tenantId AND deleted_at IS NULL
ORDER BY created_at DESC;

findAllFiltered:
SELECT * FROM key_reference
WHERE tenant_id = :tenantId AND deleted_at IS NULL
  AND (:providerId IS NULL OR provider_id = :providerId)
  AND (:alias IS NULL OR alias = :alias)
  AND (:kid IS NULL OR kid = :kid)
  AND (:origin IS NULL OR origin = :origin)
  AND (:keyType IS NULL OR key_type = :keyType)
ORDER BY created_at DESC;

existsByAliasAndProvider:
SELECT COUNT(*) FROM key_reference
WHERE tenant_id = :tenantId AND alias = :alias AND provider_id = :providerId
  AND deleted_at IS NULL;

insertRecord:
INSERT INTO key_reference(
    id, tenant_id, alias, kid, provider_id, origin, control_mode,
    key_type, signature_algorithm, key_visibility, key_encoding, public_key_jwk, wallet_unit_id,
    created_at, created_by_id, updated_at, updated_by_id
) VALUES (
    :id, :tenantId, :alias, :kid, :providerId, :origin, :controlMode,
    :keyType, :signatureAlgorithm, :keyVisibility, :keyEncoding, :publicKeyJwk, :walletUnitId,
    :createdAt, :createdById, :updatedAt, :updatedById
);

updateRecord:
UPDATE key_reference SET
    kid = :kid,
    origin = :origin,
    control_mode = :controlMode,
    key_type = :keyType,
    signature_algorithm = :signatureAlgorithm,
    key_visibility = :keyVisibility,
    key_encoding = :keyEncoding,
    -- A known public key is never replaced by an unknown one.
    public_key_jwk = COALESCE(:publicKeyJwk, public_key_jwk),
    -- Ownership is immutable once a reference exists. In particular, do not let a later
    -- registration relabel a durable key from one wallet unit to another. Legacy rows with no
    -- owner remain explicitly unowned and are rejected by wallet WSCD rehydration.
    wallet_unit_id = wallet_unit_id,
    updated_at = :updatedAt,
    updated_by_id = :updatedById
WHERE id = :id AND deleted_at IS NULL;

-- Soft delete
softDelete:
UPDATE key_reference SET
    deleted_at = :deletedAt,
    deleted_by_id = :deletedById
WHERE tenant_id = :tenantId AND alias = :alias AND provider_id = :providerId
  AND deleted_at IS NULL;

softDeleteByKid:
UPDATE key_reference SET
    deleted_at = :deletedAt,
    deleted_by_id = :deletedById
WHERE tenant_id = :tenantId AND kid = :kid AND deleted_at IS NULL
  AND (:providerId IS NULL OR provider_id = :providerId);
