-- ================================================================
-- did_verification_method queries
-- ================================================================
selectVmsByDidRecord:
SELECT * FROM did_verification_method WHERE did_record_id = :didRecordId ORDER BY ordinal ASC;

selectVmsByDidRecords:
SELECT * FROM did_verification_method WHERE did_record_id IN ? ORDER BY did_record_id, ordinal ASC;

insertVm:
INSERT INTO did_verification_method(
    id, did_record_id, vm_id, vm_id_authored, type, controller,
    kms_provider_id, kms_key_alias, kms_kid, key_reference_id,
    public_key_jwk_json, public_key_multibase, inline_in_json,
    expires_at, revoked_at, blockchain_account_id, extension_properties_json,
    ordinal, created_at, created_by_id, updated_at, updated_by_id
) VALUES (
    :id, :didRecordId, :vmId, :vmIdAuthored, :type, :controller,
    :kmsProviderId, :kmsKeyAlias, :kmsKid, :keyReferenceId,
    :publicKeyJwkJson, :publicKeyMultibase, :inlineInJson,
    :expiresAt, :revokedAt, :blockchainAccountId, :extensionPropertiesJson,
    :ordinal, :createdAt, :createdById, :updatedAt, :updatedById
);

upsertVm:
INSERT OR REPLACE INTO did_verification_method(
    id, did_record_id, vm_id, vm_id_authored, type, controller,
    kms_provider_id, kms_key_alias, kms_kid, key_reference_id,
    public_key_jwk_json, public_key_multibase, inline_in_json,
    expires_at, revoked_at, blockchain_account_id, extension_properties_json,
    ordinal, created_at, created_by_id, updated_at, updated_by_id
) VALUES (
    :id, :didRecordId, :vmId, :vmIdAuthored, :type, :controller,
    :kmsProviderId, :kmsKeyAlias, :kmsKid, :keyReferenceId,
    :publicKeyJwkJson, :publicKeyMultibase, :inlineInJson,
    :expiresAt, :revokedAt, :blockchainAccountId, :extensionPropertiesJson,
    :ordinal, :createdAt, :createdById, :updatedAt, :updatedById
);

deleteVmById:
DELETE FROM did_verification_method
WHERE id = :id
  AND (:tenantId IS NULL OR did_record_id IN (SELECT id FROM did_record WHERE id = did_record_id AND tenant_id = :tenantId));

deleteVmsByDidRecord:
DELETE FROM did_verification_method WHERE did_record_id = :didRecordId;

findVmWireIdAndDidRecordById:
SELECT vm.vm_id, vm.did_record_id FROM did_verification_method vm
INNER JOIN did_record dr ON dr.id = vm.did_record_id
WHERE vm.id = :id AND (:tenantId IS NULL OR dr.tenant_id = :tenantId);

deleteRelsByEntryRefDidUrlForDid:
DELETE FROM did_verification_relationship WHERE entry_ref_did_url = :wireId AND did_record_id = :didRecordId;

-- IDK-18 o77: did_key_mapping.verification_method_id is now a UUID FK with
-- ON DELETE CASCADE — no manual cascade query needed; FK does the work.

