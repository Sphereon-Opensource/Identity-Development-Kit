<?xml version="1.0" encoding="UTF-8"?>
<!--
    Catalogue of Attributes – Specifications
    Version: 1.0.1
-->
<xsd:schema
    targetNamespace="http://data.europa.eu/c9v/catalogueOfAttributes/v1#"
    xmlns:cat="http://data.europa.eu/c9v/catalogueOfAttributes/v1#"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema"
    xmlns:ds="http://www.w3.org/2000/09/xmldsig#"
    elementFormDefault="qualified"
    attributeFormDefault="unqualified">

    <!-- Imports -->
    <xsd:import namespace="http://www.w3.org/XML/1998/namespace"
                schemaLocation="http://www.w3.org/2001/xml.xsd"/>
    <xsd:import namespace="http://www.w3.org/2000/09/xmldsig#"
                schemaLocation="http://www.w3.org/TR/2008/REC-xmldsig-core-20080610/xmldsig-core-schema.xsd"/>

 
    <xsd:complexType name="MultiLangStringType">
        <xsd:simpleContent>
            <xsd:extension base="xsd:string">
                <xsd:attribute ref="xml:lang" use="required"/>
            </xsd:extension>
        </xsd:simpleContent>
    </xsd:complexType>

    <xsd:complexType name="InternationalNamesType">
        <xsd:sequence>
            <xsd:element name="Name" type="cat:MultiLangStringType" maxOccurs="unbounded"/>
        </xsd:sequence>
    </xsd:complexType>


    <xsd:element name="Extension" type="cat:ExtensionType"/>
    <xsd:complexType name="ExtensionType">
        <xsd:sequence>
            <xsd:element name="Critical" type="xsd:boolean"/>
            <xsd:any namespace="##any" processContents="lax" minOccurs="1" maxOccurs="1"/>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="ExtensionsListType">
        <xsd:sequence>
            <xsd:element ref="cat:Extension" maxOccurs="unbounded"/>
        </xsd:sequence>
    </xsd:complexType>


    <xsd:element name="PostalAddresses" type="cat:PostalAddressListType"/>
    <xsd:complexType name="PostalAddressListType">
        <xsd:sequence>
            <xsd:element ref="cat:PostalAddress" maxOccurs="unbounded"/>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:element name="PostalAddress" type="cat:PostalAddressType"/>
    <xsd:complexType name="PostalAddressType">
        <xsd:sequence>
            <xsd:element name="StreetAddress"   type="xsd:string"/>
            <xsd:element name="Locality"        type="xsd:string"/>
            <xsd:element name="StateOrProvince" type="xsd:string" minOccurs="0"/>
            <xsd:element name="PostalCode"      type="xsd:string" minOccurs="0"/>
            <xsd:element name="Country"         type="xsd:string"/>
        </xsd:sequence>
        <xsd:attribute ref="xml:lang" use="required"/>
    </xsd:complexType>


    <xsd:element name="ElectronicAddress" type="cat:ElectronicAddressType"/>
    <xsd:complexType name="ElectronicAddressType">
        <xsd:sequence>
            <xsd:element name="URI" type="xsd:anyURI" maxOccurs="unbounded"/>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="CatalogueOperatorAddressType">
        <xsd:sequence>
            <xsd:element ref="cat:PostalAddresses"/>
            <xsd:element ref="cat:ElectronicAddress"/>
        </xsd:sequence>
    </xsd:complexType>


    <xsd:element name="CatalogueDistributionPoint" type="cat:CatalogueDistributionPointType"/>
    <xsd:complexType name="CatalogueDistributionPointType">
        <xsd:sequence>
            <xsd:element name="HomePage"    type="xsd:anyURI" minOccurs="0"/>
            <xsd:element name="LandingPage" type="xsd:anyURI" minOccurs="0"/>
            <xsd:element name="DownloadURL" type="xsd:anyURI" minOccurs="0"/>
            <xsd:element name="AccessURL"   type="xsd:anyURI" minOccurs="0"/>
        </xsd:sequence>
    </xsd:complexType>


    <xsd:element name="CatalogueOfAttributes" type="cat:CatalogueOfAttributesType"/>


    <xsd:complexType name="CatalogueOfAttributesType">
        <xsd:sequence>
            <xsd:element ref="cat:CatalogueInformation"/>
            <xsd:element ref="cat:Namespaces" minOccurs="0"/>
            <xsd:element ref="ds:Signature" minOccurs="0"/>
        </xsd:sequence>
    </xsd:complexType>


    <xsd:element name="CatalogueInformation" type="cat:CatalogueInformationType"/>
    <xsd:complexType name="CatalogueInformationType">
        <xsd:sequence>
            <xsd:element name="CatalogueVersion"                            type="xsd:integer"/>
            <xsd:element name="CatalogueSequenceNumber"                     type="xsd:positiveInteger"/>
            <xsd:element name="CatalogueIdentifier"                         type="xsd:anyURI"/>
            <xsd:element ref="cat:CatalogueName"/>
            <xsd:element name="CatalogueOperator"                           type="cat:CatalogueOperatorType"/>
            <xsd:element name="CatalogueInformationURI"                     type="xsd:anyURI"/>
            <xsd:element name="CatalogueEntriesStatusDeterminationApproach" type="xsd:anyURI" minOccurs="0"/>
            <xsd:element name="CatalogueTerritory"                          type="xsd:string"/>
            <xsd:element name="CatalogueLegalNotice"                        type="xsd:anyURI"/>
            <xsd:element name="HistoricalInformationPeriod"                 type="xsd:nonNegativeInteger"/>
            <xsd:element name="CatalogueIssueDateAndTime"                   type="xsd:dateTime"/>
            <xsd:element ref="cat:CatalogueDistributionPoint"/>
            <xsd:element name="CatalogueExtensions"                         type="cat:ExtensionsListType" minOccurs="0"/>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:element name="CatalogueName" type="cat:InternationalNamesType"/>


    <xsd:complexType name="CatalogueOperatorType">
        <xsd:sequence>
            <xsd:element name="CatalogueOperatorName"       type="cat:InternationalNamesType"/>
            <xsd:element name="CatalogueOperatorIdentifier" type="xsd:string"/>
            <xsd:element name="CatalogueOperatorAddress"    type="cat:CatalogueOperatorAddressType"/>
        </xsd:sequence>
    </xsd:complexType>


    <xsd:element name="Namespaces" type="cat:NamespacesListType"/>
    <xsd:complexType name="NamespacesListType">
        <xsd:sequence>
            <xsd:element ref="cat:Namespace" maxOccurs="unbounded"/>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:element name="Namespace" type="cat:NamespaceType"/>
    <xsd:complexType name="NamespaceType">
        <xsd:sequence>
            <xsd:element name="NamespaceIdentifier" type="xsd:string"/>
            <xsd:element name="NamespaceEntries"    type="cat:NamespaceEntryListType"/>
        </xsd:sequence>
    </xsd:complexType>


    <xsd:complexType name="NamespaceEntryListType">
        <xsd:sequence>
            <xsd:element ref="cat:NamespaceEntry" maxOccurs="unbounded"/>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:element name="NamespaceEntry" type="cat:NamespaceEntryType"/>
    <xsd:complexType name="NamespaceEntryType">
        <xsd:sequence>
            <xsd:element name="AttributeIdentifier"             type="xsd:string"/>
            <xsd:element name="AttributeRegistrationIdentifier" type="xsd:string" minOccurs="0"/>
            <xsd:element ref="ds:Reference"/>
        </xsd:sequence>
    </xsd:complexType>


    <xsd:element name="eIDASAnnexVIAttribute" type="cat:eIDASAnnexVIAttributeExtensionType"/>
    <xsd:complexType name="eIDASAnnexVIAttributeExtensionType">
        <xsd:sequence>
            <xsd:element name="eIDASAnnexVIAttributeType" type="xsd:integer"/>
        </xsd:sequence>
    </xsd:complexType>

</xsd:schema>
