<?xml version="1.0" encoding="UTF-8"?>
<!-- Offline stand-in for http://www.w3.org/2001/xml.xsd: declares only xml:lang, with the same union type as the W3C schema. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.w3.org/XML/1998/namespace">
    <xs:attribute name="lang">
        <xs:simpleType>
            <xs:union memberTypes="xs:language">
                <xs:simpleType>
                    <xs:restriction base="xs:string">
                        <xs:enumeration value=""/>
                    </xs:restriction>
                </xs:simpleType>
            </xs:union>
        </xs:simpleType>
    </xs:attribute>
</xs:schema>
