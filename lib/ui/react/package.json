{
  "name": "@sphereon/ui-react",
  "version": "0.1.0",
  "description": "Sphereon UI components for React — headless hooks + token-styled components",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./headless": {
      "types": "./dist/headless/index.d.ts",
      "import": "./dist/headless/index.js",
      "default": "./dist/headless/index.js"
    }
  },
  "scripts": {
    "build": "tsc && node -e \"const {cpSync,readdirSync}=require('fs');const {join}=require('path');function walk(d){readdirSync(d,{withFileTypes:true}).forEach(e=>{const p=join(d,e.name);if(e.isDirectory())walk(p);else if(e.name.endsWith('.module.css'))cpSync(p,p.replace('src','dist'))})}walk('src')\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@sphereon/theme-react": ">=0.1.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "react-qr-code": "^2.0.15"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^25.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "files": [
    "dist",
    "src"
  ],
  "license": "AGPL-3.0-or-later"
}
