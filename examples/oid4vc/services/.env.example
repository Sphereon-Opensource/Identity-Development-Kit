# External base URL for wallet-facing endpoints (metadata, QR codes, VCT URLs).
# Set this to your LAN IP or ngrok URL so phones can reach the services.
# If not set, start.sh will auto-detect your LAN IP.
#
# Examples:
#   EXTERNAL_BASE_URL=http://192.168.1.100:8080
#   EXTERNAL_BASE_URL=https://abc123.ngrok.io
EXTERNAL_BASE_URL=
