{
	servers {
		trusted_proxies static private_ranges
	}
}

:8080 {
	# VCT type metadata (static JSON served by Caddy)
	handle_path /oid4vci/vct/* {
		root * /srv/vct
		rewrite * /{path}.json
		file_server
		header Content-Type application/json
	}

	# Static assets (logos, background images)
	handle /assets/* {
		root * /srv
		file_server
	}

	# Web application (handle_path strips the /webapp prefix)
	handle_path /webapp/* {
		# Redirect bare /webapp/ (stripped to /) to /webapp/issuer
		@spa_root path /
		redir @spa_root /webapp/issuer permanent
		reverse_proxy webapp:8080
	}

	# =========================================================================
	# OID4VCI Issuer
	#
	# Issuer identifier: ${EXTERNAL_BASE_URL}/oid4vci
	#
	# OID4VCI §11.2.2 (per RFC 8615): the well-known URI is formed by INSERTING
	# /.well-known/openid-credential-issuer between the host and the path of the
	# Credential Issuer Identifier.
	#
	#   Identifier: https://host/oid4vci
	#   Well-known: https://host/.well-known/openid-credential-issuer/oid4vci
	#
	# We deliberately do NOT serve the metadata at the bare /.well-known/openid-credential-issuer
	# root path — no spec version places it there, and doing so would shadow any real
	# root-level issuer deployment.
	# =========================================================================

	# Spec-correct location (OID4VCI 1.0 final, per RFC 8615):
	# /.well-known is inserted between the host and the issuer path component.
	handle /.well-known/openid-credential-issuer/oid4vci {
		rewrite * /.well-known/openid-credential-issuer
		reverse_proxy oid4vci-issuer:8080
	}

	# Pre-OID4VCI-1.0-final "append" layout: earlier drafts appended the well-known
	# suffix directly to the Credential Issuer Identifier. 1.0-final aligned with
	# RFC 8615 (insert), but many deployed wallets still resolve via the old append
	# rule, so we serve it here for compatibility.
	handle /oid4vci/.well-known/openid-credential-issuer {
		rewrite * /.well-known/openid-credential-issuer
		reverse_proxy oid4vci-issuer:8080
	}

	# OID4VCI protocol + backend routes
	handle /oid4vci/* {
		reverse_proxy oid4vci-issuer:8080
	}

	# SD-JWT VC Issuer Metadata (draft-ietf-oauth-sd-jwt-vc § 3.5).
	# Served dynamically from the issuer service (KMS-backed JWKS), using the
	# RFC 8615 insert form: /.well-known/jwt-vc-issuer/<issuer-path>.
	handle /.well-known/jwt-vc-issuer {
		reverse_proxy oid4vci-issuer:8080
	}
	handle /.well-known/jwt-vc-issuer/oid4vci {
		reverse_proxy oid4vci-issuer:8080
	}

	# =========================================================================
	# OID4VP Verifier
	# =========================================================================

	handle /oid4vp/* {
		reverse_proxy oid4vp-verifier:8080
	}

	# =========================================================================
	# OAuth2 Authorization Server
	#
	# AS issuer: ${EXTERNAL_BASE_URL}/auth
	#
	# RFC 8414 (Section 3): well-known path is formed by INSERTING
	# /.well-known/oauth-authorization-server between the host and path.
	# So:  /.well-known/oauth-authorization-server/auth
	#
	# OIDC Discovery follows the same pattern for /.well-known/openid-configuration.
	# =========================================================================

	# OAuth2 AS well-known: spec-correct location per RFC 8414 (path inserted)
	handle /.well-known/oauth-authorization-server/auth {
		rewrite * /.well-known/oauth-authorization-server
		reverse_proxy oauth2-as:8080
	}
	handle /.well-known/openid-configuration/auth {
		rewrite * /.well-known/openid-configuration
		reverse_proxy oauth2-as:8080
	}

	# OAuth2 AS well-known: root fallback
	handle /.well-known/oauth-authorization-server {
		reverse_proxy oauth2-as:8080
	}
	handle /.well-known/openid-configuration {
		reverse_proxy oauth2-as:8080
	}

	# JWKS (used for JWT access token verification, not path-scoped)
	handle /.well-known/jwks.json {
		reverse_proxy oauth2-as:8080
	}

	# OAuth2 AS routes (handle_path strips /auth prefix before proxying)
	handle_path /auth/* {
		reverse_proxy oauth2-as:8080
	}

	# =========================================================================
	# Default
	# =========================================================================

	handle {
		@root_redirect {
			path / /webapp /webapp/
		}
		redir @root_redirect /webapp/issuer permanent
	}
}
