{
	servers {
		trusted_proxies static private_ranges
	}
}

# Reusable CORS handler for endpoints that browser-based wallets may call from a different origin.
# Echoes the Origin header (rather than wildcarding) so browsers permit credentialed / custom-header
# requests (DPoP, OAuth-Client-Attestation*) without weakening security to "any origin can read".
# Developer-demo policy: any origin permitted.
(cors) {
	@cors_origin header_regexp Origin .+
	@cors_preflight {
		method OPTIONS
		header_regexp Origin .+
	}

	header @cors_origin {
		Access-Control-Allow-Origin "{http.request.header.Origin}"
		Vary "Origin"
		Access-Control-Allow-Methods "GET, POST, OPTIONS"
		Access-Control-Allow-Headers "Content-Type, Authorization, Accept, DPoP, OAuth-Client-Attestation, OAuth-Client-Attestation-PoP"
		Access-Control-Expose-Headers "WWW-Authenticate, DPoP-Nonce"
		Access-Control-Max-Age "600"
	}

	respond @cors_preflight 204
}

# All routing rules live in this snippet so the plain-HTTP (:8080) site here and the
# TLS (:8443) site in Caddyfile.conformance share one source of truth. Caddyfile.conformance
# imports this file and references this snippet — touching a route in one place updates both
# surfaces.
(routes) {
	# VCT type metadata is served dynamically by the issuer on its public hosting surface
	# (GET /public/schema/vct/{vctId}), derived from the same `oid4vci.issuer` config that drives the OID4VCI
	# metadata — one authoring source. Routed via the dedicated `/public/schema/vct/*` handler below
	# (alongside `/public/statuslists/*`). No static VCT files are mounted.

	# Static assets (logos, background images) — same-origin only.
	handle /assets/* {
		root * /srv
		file_server
	}

	# Web application (handle_path strips the /webapp prefix) — same-origin SPA, no CORS.
	handle_path /webapp/* {
		# Redirect bare /webapp/ (stripped to /) to /webapp/issuer
		@spa_root path /
		redir @spa_root /webapp/issuer permanent
		reverse_proxy webapp:8080
	}

	# =========================================================================
	# OID4VCI Issuer
	#
	# Issuer identifier: ${EXTERNAL_BASE_URL}/oid4vci
	#
	# OID4VCI §11.2.2 (per RFC 8615): the well-known URI is formed by INSERTING
	# /.well-known/openid-credential-issuer between the host and the path of the
	# Credential Issuer Identifier.
	#
	#   Identifier: https://host/oid4vci
	#   Well-known: https://host/.well-known/openid-credential-issuer/oid4vci
	#
	# We deliberately do NOT serve the metadata at the bare /.well-known/openid-credential-issuer
	# root path — no spec version places it there, and doing so would shadow any real
	# root-level issuer deployment.
	# =========================================================================

	# Spec-correct location (OID4VCI 1.0 final, per RFC 8615):
	# /.well-known is inserted between the host and the issuer path component.
	handle /.well-known/openid-credential-issuer/oid4vci {
		import cors
		reverse_proxy oid4vci-issuer:8080
	}

	# Pre-OID4VCI-1.0-final "append" layout: earlier drafts appended the well-known
	# suffix directly to the Credential Issuer Identifier. 1.0-final aligned with
	# RFC 8615 (insert), but many deployed wallets still resolve via the old append
	# rule, so we serve it here for compatibility.
	handle /oid4vci/.well-known/openid-credential-issuer {
		import cors
		reverse_proxy oid4vci-issuer:8080
	}

	# OID4VCI protocol + backend routes
	handle /api/oid4vci/v1/* {
		import cors
		reverse_proxy oid4vci-issuer:8080
	}

	handle /oid4vci/* {
		import cors
		reverse_proxy oid4vci-issuer:8080
	}

	# Credential status list hosting (public, cacheable) — GET /public/statuslists/{id}.
	# Protocol-neutral public path; the issuer service serves the signed status-list token here.
	handle /public/statuslists/* {
		import cors
		reverse_proxy oid4vci-issuer:8080
	}

	# Public schema hosting (public, cacheable) — e.g. SD-JWT VC type metadata at
	# GET /public/schema/vct/{vctId}. Stable, unauthenticated paths that issued credentials embed
	# (e.g. their `vct`); the issuer serves the documents here, decoupled from the `/oid4vci` protocol
	# surface. Routed at the `/public/schema` parent so future schema types need no new gateway rule.
	handle /public/schema/* {
		import cors
		reverse_proxy oid4vci-issuer:8080
	}

	# Credential status list management (by-index admin) — read / revoke / clear.
	# Decoupled from the public hosting surface above; mounted at the versioned, singular
	# management base. The issuer service serves the admin endpoints here.
	handle /api/statuslist/v1/* {
		import cors
		reverse_proxy oid4vci-issuer:8080
	}

	# SD-JWT VC Issuer Metadata (draft-ietf-oauth-sd-jwt-vc § 3.5).
	# Served dynamically from the issuer service (KMS-backed JWKS), using the
	# RFC 8615 insert form: /.well-known/jwt-vc-issuer/<issuer-path>.
	handle /.well-known/jwt-vc-issuer {
		import cors
		reverse_proxy oid4vci-issuer:8080
	}
	handle /.well-known/jwt-vc-issuer/oid4vci {
		import cors
		reverse_proxy oid4vci-issuer:8080
	}

	# did:web document for the issuer's signing DID (did:web:<host>). Served by the issuer's
	# DID-hosting endpoint, derived from its signing key. Host header is preserved so the
	# hosting endpoint computes the public web location.
	handle /.well-known/did.json {
		import cors
		reverse_proxy oid4vci-issuer:8080
	}

	# =========================================================================
	# OID4VP Verifier
	# =========================================================================

	handle /oid4vp/* {
		import cors
		reverse_proxy oid4vp-verifier:8080
	}

	# =========================================================================
	# OAuth2 Authorization Server
	#
	# AS issuer: ${EXTERNAL_BASE_URL}/auth
	#
	# RFC 8414 (Section 3): well-known path is formed by INSERTING
	# /.well-known/oauth-authorization-server between the host and path.
	# So:  /.well-known/oauth-authorization-server/auth
	#
	# OIDC Discovery follows the same pattern for /.well-known/openid-configuration.
	# =========================================================================

	# OAuth2 AS well-known: spec-correct location per RFC 8414 (path inserted)
	handle /.well-known/oauth-authorization-server/auth {
		import cors
		rewrite * /.well-known/oauth-authorization-server
		reverse_proxy oauth2-as:8080
	}
	handle /.well-known/openid-configuration/auth {
		import cors
		rewrite * /.well-known/openid-configuration
		reverse_proxy oauth2-as:8080
	}

	# OAuth2 AS well-known: root fallback
	handle /.well-known/oauth-authorization-server {
		import cors
		reverse_proxy oauth2-as:8080
	}
	handle /.well-known/openid-configuration {
		import cors
		reverse_proxy oauth2-as:8080
	}

	# JWKS (used for JWT access token verification, not path-scoped)
	handle /.well-known/jwks.json {
		import cors
		reverse_proxy oauth2-as:8080
	}

	# OAuth2 AS routes (handle_path strips /auth prefix before proxying)
	handle_path /auth/* {
		import cors
		reverse_proxy oauth2-as:8080 {
			# The AS renders the login surface under the deployment's /auth prefix (the
			# authorize→login redirect and the form action both target /auth/login) but hardcodes
			# the CSRF cookie as Path=/login — it's not deployment-path-aware. Rewrite the cookie
			# Path to the external /auth/login so the browser actually sends `oidc_login_csrf` on
			# the form POST. Without this the login POST fails with "Missing CSRF parameters".
			header_down Set-Cookie "Path=/login" "Path=/auth/login"
		}
	}

	# Login page + static assets. The bundled `SphereonBrandedLoginPageRenderer` emits
	# host-absolute paths — `<link href="/login/assets/css/login.css">`, `<form action="/login">` —
	# without the deployment's `/auth` prefix (the renderer is not deployment-path-aware). Mirror
	# both at the Caddy edge so the form submits and the assets load. `handle` (no path strip)
	# preserves `/login` and `/login/assets/*` verbatim for the AS, matching the routes registered
	# by `LoginPageHttpEndpointCommandImpl` / `LoginSubmitHttpEndpointCommandImpl` /
	# `LoginAssetHttpEndpointCommandImpl`.
	@login_routes path /login /login/*
	handle @login_routes {
		import cors
		reverse_proxy oauth2-as:8080
	}

	# =========================================================================
	# Default
	# =========================================================================

	handle {
		@root_redirect {
			path / /webapp /webapp/
		}
		redir @root_redirect /webapp/issuer permanent
	}
}

# Plain HTTP listener used by the regular dev demo. The conformance setup
# (start-conformance-dev.{sh,bat}) layers a separate TLS listener on top via
# Caddyfile.conformance — see that file when running the OIDF FAPI2 suite.
:8080 {
	import routes
}
