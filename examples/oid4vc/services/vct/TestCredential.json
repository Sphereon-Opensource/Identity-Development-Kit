{
  "vct": "TestCredential",
  "name": "Test Credential",
  "description": "A test SD-JWT verifiable credential for E2E wallet testing",
  "display": [
    {
      "locale": "en-US",
      "name": "Test Credential",
      "description": "A simple test credential containing basic identity claims",
      "rendering": {
        "simple": {
          "logo": {
            "uri": "EXTERNAL_BASE_URL/assets/sphereon-logo.png",
            "alt_text": "Sphereon"
          },
          "background_image": {
            "uri": "EXTERNAL_BASE_URL/assets/sphereon-background.png"
          },
          "background_color": "#1a56db",
          "text_color": "#ffffff"
        }
      }
    },
    {
      "locale": "de-DE",
      "name": "Testnachweis",
      "description": "Ein einfacher Testnachweis mit grundlegenden Identitätsdaten",
      "rendering": {
        "simple": {
          "logo": {
            "uri": "EXTERNAL_BASE_URL/assets/sphereon-logo.png",
            "alt_text": "Sphereon"
          },
          "background_image": {
            "uri": "EXTERNAL_BASE_URL/assets/sphereon-background.png"
          },
          "background_color": "#1a56db",
          "text_color": "#ffffff"
        }
      }
    },
    {
      "locale": "es-ES",
      "name": "Credencial de Prueba",
      "description": "Una credencial verificable de prueba con datos de identidad básicos",
      "rendering": {
        "simple": {
          "logo": {
            "uri": "EXTERNAL_BASE_URL/assets/sphereon-logo.png",
            "alt_text": "Sphereon"
          },
          "background_image": {
            "uri": "EXTERNAL_BASE_URL/assets/sphereon-background.png"
          },
          "background_color": "#1a56db",
          "text_color": "#ffffff"
        }
      }
    },
    {
      "locale": "nl-NL",
      "name": "Testcredential",
      "description": "Een eenvoudige testcredential met basisidentiteitsgegevens",
      "rendering": {
        "simple": {
          "logo": {
            "uri": "EXTERNAL_BASE_URL/assets/sphereon-logo.png",
            "alt_text": "Sphereon"
          },
          "background_image": {
            "uri": "EXTERNAL_BASE_URL/assets/sphereon-background.png"
          },
          "background_color": "#1a56db",
          "text_color": "#ffffff"
        }
      }
    }
  ],
  "claims": [
    {
      "path": ["given_name"],
      "display": [
        { "locale": "en-US", "label": "Given Name", "description": "First name of the holder" },
        { "locale": "de-DE", "label": "Vorname", "description": "Vorname des Inhabers" },
        { "locale": "es-ES", "label": "Nombre", "description": "Nombre del titular" },
        { "locale": "nl-NL", "label": "Voornaam", "description": "Voornaam van de houder" }
      ],
      "sd": "always"
    },
    {
      "path": ["family_name"],
      "display": [
        { "locale": "en-US", "label": "Family Name", "description": "Last name of the holder" },
        { "locale": "de-DE", "label": "Nachname", "description": "Nachname des Inhabers" },
        { "locale": "es-ES", "label": "Apellido", "description": "Apellido del titular" },
        { "locale": "nl-NL", "label": "Achternaam", "description": "Achternaam van de houder" }
      ],
      "sd": "always"
    },
    {
      "path": ["email"],
      "display": [
        { "locale": "en-US", "label": "Email", "description": "Email address of the holder" },
        { "locale": "de-DE", "label": "E-Mail", "description": "E-Mail-Adresse des Inhabers" },
        { "locale": "es-ES", "label": "Correo electrónico", "description": "Dirección de correo electrónico del titular" },
        { "locale": "nl-NL", "label": "E-mail", "description": "E-mailadres van de houder" }
      ],
      "sd": "always"
    }
  ]
}
