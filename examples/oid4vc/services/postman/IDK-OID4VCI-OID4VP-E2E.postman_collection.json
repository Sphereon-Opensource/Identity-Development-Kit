{
  "info": {
    "name": "IDK OID4VCI + OID4VP E2E",
    "description": "End-to-end testing collection for OID4VCI credential issuance and OID4VP credential presentation.\n\nRequires the IDK E2E docker-compose environment running.\n\nSet the `base_url` variable to your EXTERNAL_BASE_URL (e.g., http://192.168.1.100:8080).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "pre_auth_code",
      "value": "",
      "type": "string"
    },
    {
      "key": "tx_code",
      "value": "",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "c_nonce",
      "value": "",
      "type": "string"
    },
    {
      "key": "offer_uri",
      "value": "",
      "type": "string"
    },
    {
      "key": "correlation_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "auth_request_correlation_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "request_uri",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Setup",
      "item": [
        {
          "name": "Health Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/auth/health"
          }
        },
        {
          "name": "Issuer Metadata",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Issuer identifier is present', () => pm.expect(pm.response.json().credential_issuer).to.eql(pm.collectionVariables.get('base_url') + '/oid4vci'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/.well-known/openid-credential-issuer/oid4vci"
          }
        },
        {
          "name": "AS Discovery",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Token endpoint uses auth prefix', () => pm.expect(pm.response.json().token_endpoint).to.eql(pm.collectionVariables.get('base_url') + '/auth/token'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/.well-known/oauth-authorization-server/auth"
          }
        }
      ]
    },
    {
      "name": "Pre-Authorized Code Flow",
      "item": [
        {
          "name": "1. Create Credential Offer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "pm.collectionVariables.set('offer_uri', json.offer_uri);",
                  "pm.collectionVariables.set('correlation_id', json.correlation_id);",
                  "",
                  "function storePreAuthCode(offer) {",
                  "  if (offer.grants && offer.grants['urn:ietf:params:oauth:grant-type:pre-authorized_code']) {",
                  "    pm.collectionVariables.set('pre_auth_code', offer.grants['urn:ietf:params:oauth:grant-type:pre-authorized_code']['pre-authorized_code']);",
                  "  }",
                  "}",
                  "",
                  "// Extract pre-auth code from inline credential_offer or fetched credential_offer_uri",
                  "if (json.offer_uri) {",
                  "  try {",
                  "    var uri = decodeURIComponent(json.offer_uri);",
                  "    var offerParam = uri.split('credential_offer=')[1];",
                  "    if (offerParam) {",
                  "      var offer = JSON.parse(decodeURIComponent(offerParam));",
                  "      storePreAuthCode(offer);",
                  "    } else {",
                  "      var offerUriParam = uri.split('credential_offer_uri=')[1];",
                  "      if (offerUriParam) {",
                  "        pm.sendRequest(decodeURIComponent(offerUriParam), function (err, res) {",
                  "          if (!err && res.code === 200) storePreAuthCode(res.json());",
                  "        });",
                  "      }",
                  "    }",
                  "  } catch(e) { console.log('Could not parse offer URI: ' + e); }",
                  "}",
                  "if (json.tx_code) pm.collectionVariables.set('tx_code', json.tx_code);",
                  "",
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"credential_configuration_ids\": [\"TestCredential\"],\n  \"grants\": {\n    \"pre_authorized_code\": {\n      \"tx_code\": {\n        \"input_mode\": \"numeric\",\n        \"length\": 6\n      }\n    }\n  },\n  \"qr_code\": {\n    \"size\": 300\n  }\n}"
            },
            "url": "{{base_url}}/api/oid4vci/v1/backend/credential/offers"
          }
        },
        {
          "name": "2. Get Offer Status",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/oid4vci/v1/backend/credential/offers/{{correlation_id}}"
          }
        },
        {
          "name": "3. Exchange Pre-Auth Code for Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.access_token) pm.collectionVariables.set('access_token', json.access_token);",
                  "if (json.c_nonce) pm.collectionVariables.set('c_nonce', json.c_nonce);",
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "urn:ietf:params:oauth:grant-type:pre-authorized_code"
                },
                {
                  "key": "pre-authorized_code",
                  "value": "{{pre_auth_code}}"
                },
                {
                  "key": "tx_code",
                  "value": "{{tx_code}}"
                }
              ]
            },
            "url": "{{base_url}}/auth/token"
          }
        },
        {
          "name": "4. Request Nonce",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.c_nonce) pm.collectionVariables.set('c_nonce', json.c_nonce);",
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/oid4vci/nonce"
          }
        },
        {
          "name": "5. Request Credential (SD-JWT)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"credential_configuration_id\": \"TestCredential\",\n  \"proofs\": {\n    \"jwt\": [\"<INSERT_JWT_PROOF_HERE>\"]\n  }\n}"
            },
            "url": "{{base_url}}/oid4vci/credential",
            "description": "Replace <INSERT_JWT_PROOF_HERE> with a valid JWT proof containing the c_nonce. In a real flow, the wallet generates this."
          }
        }
      ]
    },
    {
      "name": "Authorization Code Flow",
      "item": [
        {
          "name": "1. Create Credential Offer (Auth Code)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "pm.collectionVariables.set('offer_uri', json.offer_uri);",
                  "pm.collectionVariables.set('correlation_id', json.correlation_id);",
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"credential_configuration_ids\": [\"TestCredential\"],\n  \"grants\": {\n    \"authorization_code\": {\n      \"issuer_state\": \"test-state-123\"\n    }\n  },\n  \"qr_code\": {\n    \"size\": 300\n  }\n}"
            },
            "url": "{{base_url}}/api/oid4vci/v1/backend/credential/offers"
          }
        },
        {
          "name": "2. Open Authorization URL (Manual)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/auth/authorize?response_type=code&client_id=wallet&redirect_uri=http://localhost:3000/callback&scope=openid%20TestCredential&state=random123&code_challenge=E9Melhoa2OwvFrEMTJguCHaoeK1t8URWbuGJSstw-cM&code_challenge_method=S256",
            "description": "Open this URL in a browser. Login with testuser/testpass. After redirect, extract the 'code' query parameter for the next step."
          }
        },
        {
          "name": "3. Exchange Auth Code for Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.access_token) pm.collectionVariables.set('access_token', json.access_token);",
                  "if (json.c_nonce) pm.collectionVariables.set('c_nonce', json.c_nonce);",
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "authorization_code"
                },
                {
                  "key": "code",
                  "value": "<PASTE_AUTH_CODE_HERE>"
                },
                {
                  "key": "redirect_uri",
                  "value": "http://localhost:3000/callback"
                },
                {
                  "key": "client_id",
                  "value": "wallet"
                },
                {
                  "key": "code_verifier",
                  "value": "dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk"
                }
              ]
            },
            "url": "{{base_url}}/auth/token"
          }
        },
        {
          "name": "4. Request Credential (SD-JWT)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"credential_configuration_id\": \"TestCredential\",\n  \"proofs\": {\n    \"jwt\": [\"<INSERT_JWT_PROOF_HERE>\"]\n  }\n}"
            },
            "url": "{{base_url}}/oid4vci/credential"
          }
        }
      ]
    },
    {
      "name": "OID4VP Verification",
      "item": [
        {
          "name": "1. Create Authorization Request",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.correlation_id) pm.collectionVariables.set('auth_request_correlation_id', json.correlation_id);",
                  "if (json.request_uri) pm.collectionVariables.set('request_uri', json.request_uri);",
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dcql_query\": {\n    \"credentials\": [\n      {\n        \"id\": \"test_credential\",\n        \"format\": \"vc+sd-jwt\",\n        \"meta\": {\n          \"vct_values\": [\"{{base_url}}/public/schema/vct/TestCredential\"]\n        },\n        \"claims\": [\n          { \"path\": [\"given_name\"] },\n          { \"path\": [\"family_name\"] },\n          { \"path\": [\"email\"] }\n        ]\n      }\n    ]\n  },\n  \"qr_code\": {\n    \"size\": 300\n  }\n}",
              "description": "Uses the collection base_url variable for the VCT value."
            },
            "url": "{{base_url}}/oid4vp/backend/auth/requests"
          }
        },
        {
          "name": "2. Get Auth Request Status",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/oid4vp/backend/auth/requests/{{auth_request_correlation_id}}"
          }
        },
        {
          "name": "3. Fetch Request Object",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/oid4vp/request-uri/{{auth_request_correlation_id}}",
            "description": "Returns the signed authorization request (JAR) that wallets fetch when scanning the QR code."
          }
        },
        {
          "name": "4. Check Verification Result",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/oid4vp/backend/auth/requests/{{auth_request_correlation_id}}",
            "description": "After the wallet submits the VP via direct_post, this endpoint shows the verification result."
          }
        }
      ]
    }
  ]
}
