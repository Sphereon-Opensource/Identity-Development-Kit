# OIDF conformance profile: client_id prefix = did:jwk
#
# Verifier signs the JAR with its keystore signing key and emits
#   client_id = decentralized_identifier:<did:jwk derived from key>
#   JOSE kid  = <did:jwk>#0
#
# Works with any EC signing key out of the box; no SAN / cert-hash needed.
#
# Usage:
#   docker compose --env-file profiles/conformance-did-jwk.env up -d

VERIFIER_CLIENT_ID_PREFIX=did:jwk
VERIFIER_SAN_DNS_NAME=
VERIFIER_CERT_HASH=
