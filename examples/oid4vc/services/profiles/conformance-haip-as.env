# OIDF conformance profile: HAIP-shaped OAuth2 Authorization Server
#
# Flips the AS into the auth-method / DPoP / attestation shape that the OIDF
# OID4VCI HAIP test plan probes for:
#
#   - token_endpoint_auth_methods_supported = [attest_jwt_client_auth] (HAIP-2.4)
#     (per the IANA "OAuth Token Endpoint Authentication Methods" registry,
#      registered by the OAuth Attestation-based Client Authentication spec.
#      The OIDF condition CheckDiscEndpointClientAttestationSigningAlgValuesSupported
#      / OAuth2-ATCA07-10.1 fails on the older `client_attestation` literal.)
#   - dpop = REQUIRED, dpop_nonce_required = true                    (HAIP-2.4 / RFC 9449 §8)
#   - attestation = REQUIRED                                         (OAuth2-ATCA-07)
#   - par = REQUIRED                                                 (FAPI2-SP §5.3.1.1)
#   - pkce already REQUIRED in the base config                       (HAIP-2.4)
#
# Compose this with a verifier prefix profile when running OID4VP HAIP plans:
#
#   docker compose \
#       --env-file profiles/conformance-haip-as.env \
#       --env-file profiles/conformance-x509-hash.env up -d
#
# Or use the start-dev script's `haip` second arg, which layers both for you:
#
#   ./start-dev.sh https://my.ngrok.app haip

OAUTH2_DPOP_POLICY=REQUIRED
OAUTH2_DPOP_NONCE_REQUIRED=true
OAUTH2_ATTESTATION_POLICY=REQUIRED
# FAPI2-SP §5.3.1.1: every authorization request MUST go through PAR.
OAUTH2_PAR_POLICY=REQUIRED
OAUTH2_TOKEN_ENDPOINT_AUTH_METHODS=attest_jwt_client_auth

# Note on credential response encryption: HAIP §8 mandates encrypted responses for
# sd_jwt_vc / mdoc, but advertising `encryption_required: true` triggers the OIDF
# `VCIEnsureCredentialRequestEncryptionWhenResponseEncryptionRequired` cascade — it then
# expects the issuer to ALSO publish `credential_request_encryption.jwks` for reverse-
# direction request encryption (OID4VCI 1.1, Phase 2 work). The default alg/enc lists in
# oid4vci-issuer.yml advertise `encryption_required: false`, the suite's
# `vci_credential_encryption=encrypted` variant still works (the wallet asks for response
# encryption, the issuer encrypts), and no other conformance test exercises encryption.
# Set OID4VCI_RESPONSE_ENCRYPTION_REQUIRED=true here once Phase 2 (request encryption)
# lands.

# Surfaces HAIP mode to the webapp frontend (via /api/config) so the verifier UI
# locks response_mode=direct_post.jwt + request_uri_method=post per HAIP §5.
DEMO_PROFILE=haip

# HAIP §4.4.1 wallet attestation trust. Wallets sign Client Attestation JWTs with their
# attester's leaf cert, carrying the chain in the `x5c` JOSE header. The AS validates that
# chain against the configured X.509 trust anchors. The OIDF conformance suite generates
# fresh wallet-attester keys per run, anchored at the cert pasted into the test plan's
# `vci.client_attestation_trust_anchor` field — drop the same PEM at the path below before
# starting the stack so the leaf chains all the way back. With no anchor configured the AS
# falls back to per-client `trustedAttesterJwks` JWK pinning (draft -07/-08 strict default).
TRUST_ANCHORS_X509_ENABLED=true
TRUST_ANCHORS_X509_CA_BUNDLE_PATHS_0=/app/trust-anchors/wallet-attester-ca.pem
