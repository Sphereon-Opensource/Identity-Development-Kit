# OIDF conformance profile: client_id prefix = x509_san_dns
#
# Verifier signs the JAR and emits
#   client_id   = x509_san_dns:<VERIFIER_SAN_DNS_NAME>
#   JOSE x5c    = chain from the leaf cert at the configured key alias
#
# The dNSName below MUST match a SAN entry in that leaf cert. The keystore
# generation script (lib/generate-keystores.{sh,ps1}) bakes
# "verifier.example.com" into the verifier cert by default; change both here
# and in the script if you need a different name.
#
# Usage:
#   docker compose --env-file profiles/conformance-x509-san-dns.env up -d

VERIFIER_CLIENT_ID_PREFIX=x509_san_dns
VERIFIER_SAN_DNS_NAME=verifier.example.com
VERIFIER_CERT_HASH=

# HAIP §4.3: sign the SD-JWT credentials AND their status list with the issuer cert chain in the
# JOSE x5c header (one issuer identity). Wallets/verifiers must trust the demo CA (IDK E2E CA)
# out-of-band for chain validation.
OID4VCI_SIGNING_MODE=x5c
