# OIDF conformance profile: client_id prefix = x509_hash
#
# Verifier signs the JAR and emits
#   client_id   = x509_hash:<base64url(SHA-256(DER(leaf cert)))>
#   JOSE x5c    = chain from the leaf cert at the configured key alias
#
# The verifier derives the hash on the fly from the leaf cert in `x5c[0]`
# per OID4VP §5.9.3 ("MUST match the hash of the leaf certificate passed
# with the request") — no env var carries it.
#
# Usage:
#   docker compose --env-file profiles/conformance-x509-hash.env up -d

VERIFIER_CLIENT_ID_PREFIX=x509_hash
VERIFIER_SAN_DNS_NAME=
