# OIDF conformance overlay: OIDC Core Basic Certification Profile (AS / OP role).
#
# The Basic Profile predates PKCE and runs without it; the AS's default `pkce: REQUIRED`
# would reject every authorization request from the suite. Loosen to SUPPORTED so the
# clients without `code_challenge` are accepted, while clients that DO send PKCE still
# get it verified.
OAUTH2_PKCE_POLICY=SUPPORTED

# Make sure PAR is OPTIONAL — the Basic Profile sends inline /authorize requests.
# (`SUPPORTED` is the YAML default, but pin it here so a stale shell env from a HAIP
# run doesn't bleed into this run.)
OAUTH2_PAR_POLICY=SUPPORTED

# Revert token-endpoint auth methods to the YAML default so client_secret_basic /
# client_secret_post are advertised — the haip profile narrows this to
# attest_jwt_client_auth only, which would hide the OIDC Basic confidential clients.
OAUTH2_TOKEN_ENDPOINT_AUTH_METHODS=client_secret_basic,client_secret_post
