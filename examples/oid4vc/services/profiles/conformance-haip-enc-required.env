# OIDF conformance overlay: flip credential response encryption from SUPPORTED to REQUIRED.
#
# Layer this on top of profiles/conformance-haip-as.env (the start-conformance-dev.{sh,bat}
# `haip-enc-required` profile does that automatically). Use it for OIDF plans that
# specifically test the `encryption_required: true` path — the issuer will then
# advertise `credential_response_encryption.encryption_required: true` in metadata and
# reject any credential request that omits `credential_response_encryption` with HTTP 400
# `invalid_encryption_parameters` (per OID4VCI 1.0 §10).
#
# Most plans do NOT need this overlay — the regular `haip` profile is sufficient because the
# OIDF suite's `vci_credential_encryption=encrypted` variant already exercises the encrypted
# path when the issuer advertises encryption as supported.
#
# WARNING: with `encryption_required: true` the suite's
# `VCIEnsureCredentialRequestEncryptionWhenResponseEncryptionRequired` condition kicks in
# and demands `credential_request_encryption.jwks` (reverse-direction request encryption,
# OID4VCI 1.1). Until that lands the cascade may flag findings on plans that exercise it.
OID4VCI_RESPONSE_ENCRYPTION_REQUIRED=true
# OID4VCI 1.0 §11.2.4: when response encryption is REQUIRED, the OIDF
# `VCIEnsureCredentialRequestEncryptionWhenResponseEncryptionRequired` condition demands
# `credential_request_encryption.jwks` be advertised AND that request encryption be required
# in lockstep. Independent flag here so operators can advertise request encryption without
# requiring it (or vice versa); the haip-enc-required profile turns BOTH on so the OIDF
# cascade check passes.
OID4VCI_REQUEST_ENCRYPTION_REQUIRED=true
