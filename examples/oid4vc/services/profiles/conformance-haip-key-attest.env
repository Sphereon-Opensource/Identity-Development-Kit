# OIDF conformance overlay: enable OID4VCI 1.0 §7.2 key attestations on EuPid + Mdl.
#
# Layer this on top of profiles/conformance-haip-as.env (the start-conformance-dev.{sh,bat}
# `haip-key-attest` profile does that automatically). Use this for the key-attestation
# tests in the OIDF VCI HAIP plan (notably
# `oid4vci-1_0-issuer-fail-invalid-key-attestation-signature`, which silently skips when
# the issuer doesn't advertise `key_attestations_required`).
#
# DELIBERATELY ORTHOGONAL TO ENCRYPTION: this profile leaves
# OID4VCI_RESPONSE_ENCRYPTION_REQUIRED / OID4VCI_REQUEST_ENCRYPTION_REQUIRED at their
# defaults (false) so the wallet sim can still pick the plain-credential variant. Combine
# with `haip-enc-required` only when you specifically want both required at once.
#
OID4VCI_EUPID_KEY_ATTESTATIONS_REQUIRED=true
OID4VCI_MDL_KEY_ATTESTATIONS_REQUIRED=true
